/**
 * One candidate responding station's time to reach an incident, under one scenario.
 *
 * Returned as a ranked list by {@link EmsRouter#respond} for the same reason as
 * {@link HospitalEta}: knowing how much slower the second-nearest station is tells you
 * whether the first one's route is a single point of failure.
 */
type StationEta {

  /**
   * Id of the candidate {@link EmsStation}.
   */
  stationId: string

  /**
   * Display name of the candidate station.
   */
  stationName: string

  /**
   * "fire_station" or "ems_station", mirroring {@link EmsStation#stationKind}.
   */
  stationKind: string

  /**
   * Driving time in seconds from the station to the incident under the active scenario,
   * or null when the incident cannot be reached from it.
   */
  seconds: double

  /**
   * Driven distance in metres, or null when unreachable.
   */
  meters: double

  /**
   * False when no path exists from this station to the incident under the active
   * scenario.
   */
  isReachable: boolean
}
